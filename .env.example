# mock = Mock Service Worker simulates every backend API in the browser (default, demo only)
# http = call a real backend at VITE_API_BASE_URL (requires infrastructure that is NOT part of this repo)
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Demo only: persist open workspace tabs (fictional data) in localStorage
VITE_DEMO_LOCAL_PERSISTENCE=true
# Session lifetime for the demo identity adapter, in minutes
VITE_DEMO_SESSION_MINUTES=20
